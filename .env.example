# =============================================================================
# Tricarios Backend — Variables de entorno
# =============================================================================

# Servidor
NODE_ENV=development
PORT=3015
HOST=http://localhost:3015

# MongoDB
MONGO_URI=mongodb://localhost:27017/TricariosMongoDB

# JWT
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme_refresh

# PayPal
PAYPAL_API_CLIENT=
PAYPAL_API_SECRET=

# MercadoPago
MP_ACCESS_TOKEN=
MP_ACCESS_TOKENtest=
MP_PUBLIC_KEY=
MP_PUBLIC_KEYtest=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# =============================================================================
# Integración con Río Gestión (ERP)
# =============================================================================
# Base URL del backend RG (tunnel Cloudflare u origen directo).
RG_API_BASE_URL=https://gestion.tricariosgrowshop.com
# API key emitida desde RG > Configuración > Integraciones (queda hasheada en RG).
RG_API_KEY=
# Secreto compartido para verificar la firma HMAC-SHA256 de los webhooks entrantes.
RG_WEBHOOK_SECRET=
# ID de Mongo de la categoría por defecto para productos creados desde RG (opcional).
RG_DEFAULT_CATEGORY_ID=
# Activa/desactiva todo el módulo de integración sin tener que tocar código.
RG_INTEGRATION_ENABLED=true
# Timeout (ms) para las llamadas salientes al backend RG.
RG_REQUEST_TIMEOUT_MS=15000
